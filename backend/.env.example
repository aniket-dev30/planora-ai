# Server
# Local development; set NODE_ENV=production in deployment (auth fails closed outside development/test).
NODE_ENV=development
PORT=5000
# Allowed browser origin(s) for CORS. Comma-separate multiple (no trailing slash needed).
FRONTEND_URL=http://localhost:5173
# Set when running behind a reverse proxy/PaaS (e.g. 1) so per-IP limits see the real client IP.
# TRUST_PROXY=1

# Public-demo OIDC access control (required in production; leave unset for local development).
# Set from your Auth0 tenant and single authorized user's subject identifier.
# OIDC_ISSUER_URL=https://your-tenant.example.auth0.com/
# OIDC_AUDIENCE=https://planora-api
# OIDC_JWKS_URL=https://your-tenant.example.auth0.com/.well-known/jwks.json
# OIDC_ALLOWED_SUBJECT=auth0|authorized-user-id

# Gemini (keep the key on the backend only; never expose it to the frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional tuning. Defaults: low, 240000 (allowed range 10000-600000).
# GEMINI_THINKING_LEVEL=low   # minimal | low | medium | high
# GEMINI_TIMEOUT_MS=240000

# Abuse protection for the plan endpoints (defaults shown)
# PLAN_RATE_LIMIT_PER_MINUTE=10
# PLAN_MAX_CONCURRENT_PER_IP=2
# PLAN_MAX_GENERATIONS_PER_DAY=50
