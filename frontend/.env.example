# Base URL of the Planora API for production builds (no trailing slash).
# Leave empty to call the same origin (/api), e.g. behind a reverse proxy.
# Baked into the bundle at build time, so it must never contain secrets.
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api (default http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
